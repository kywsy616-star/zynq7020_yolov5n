<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="yolov5n_speed_platform"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
yolov5n_speed_platform
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="yolov5n_speed_platform">
        <sdx:configuration sdx:name="yolov5n_speed_platform"
                           sdx:displayName="yolov5n_speed_platform"
                           sdx:defaultProcessorGroup="standalone_ps7_cortexa9_1"
                           sdx:runtimes="cpp">
            <sdx:description>yolov5n_speed_platform</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="yolov5n_speed_platform/boot/yolov5n_speed_platform.bif"
                            sdx:readme="yolov5n_speed_platform/boot/generic.readme"
                            sdx:qemuArguments="yolov5n_speed_platform/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_ps7_cortexa9_0"
                            sdx:bif="yolov5n_speed_platform/boot/yolov5n_speed_platform.bif"
                            sdx:readme="yolov5n_speed_platform/boot/generic.readme"
                            sdx:qemuArguments="yolov5n_speed_platform/standalone_ps7_cortexa9_0/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_ps7_cortexa9_1"
                            sdx:bif="yolov5n_speed_platform/boot/yolov5n_speed_platform.bif"
                            sdx:readme="yolov5n_speed_platform/boot/generic.readme"
                            sdx:qemuArguments="yolov5n_speed_platform/standalone_ps7_cortexa9_1/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_ps7_cortexa9_0"
                                sdx:displayName="standalone_ps7_cortexa9_0"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="yolov5n_speed_platform/standalone_ps7_cortexa9_0/bsplib/lib"
                        sdx:bspIncludePaths="yolov5n_speed_platform/standalone_ps7_cortexa9_0/bspinclude/include"
                        sdx:bspConfig="yolov5n_speed_platform/standalone_ps7_cortexa9_0/system.mss"
                />
            </sdx:processorGroup>
            <sdx:processorGroup sdx:name="standalone_ps7_cortexa9_1"
                                sdx:displayName="standalone_ps7_cortexa9_1"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_1">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="yolov5n_speed_platform/standalone_ps7_cortexa9_1/bsplib/lib"
                        sdx:bspIncludePaths="yolov5n_speed_platform/standalone_ps7_cortexa9_1/bspinclude/include"
                        sdx:bspConfig="yolov5n_speed_platform/standalone_ps7_cortexa9_1/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
