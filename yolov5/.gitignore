###############################################################################
#  .gitignore — YOLOv8 项目 Git 忽略规则
#  原则: 仅上传主要代码 + 必要的训练/验证/预测结果文件，其他一律忽略
###############################################################################

# ===========================================================================
# 1. Python 编译缓存 & 字节码
# ===========================================================================
__pycache__/          # Python3 字节码缓存目录
*.py[cod]             # .pyc / .pyo / .pyd 已编译字节码文件
*$py.class            # Jython 编译产生的 class 文件

# ===========================================================================
# 2. Python 虚拟环境（无论名称如何，全部忽略）
# ===========================================================================
.venv/                # 虚拟环境目录（venv 默认名）
venv/                 # 虚拟环境目录（常见别名）
env/                  # 虚拟环境目录（常见别名）
ENV/                  # 虚拟环境目录（大写）
env.bak/              # 虚拟环境备份
venv.bak/             # 虚拟环境备份
.python-version       # pyenv 版本文件

# ===========================================================================
# 3. IDE 编辑器 & 系统文件
# ===========================================================================
.vscode/              # VS Code 工作区配置（settings.json, launch.json 等）
.idea/                # JetBrains IDE（PyCharm）配置目录
*.swp                 # Vim 交换文件
*.swo                 # Vim 交换文件
*~                    # 编辑器临时备份文件
.DS_Store             # macOS 文件夹元数据
Thumbs.db             # Windows 缩略图缓存
desktop.ini           # Windows 文件夹配置

# ===========================================================================
# 4. 操作系统 & 临时文件
# ===========================================================================
*.log                 # 日志文件（运行产生的临时日志）
*.tmp                 # 临时文件
*.temp                # 临时文件

# ===========================================================================
# 5. 软件包管理 & 依赖安装残留
# ===========================================================================
docker/ 
*.egg                 # setuptools 打包产物
*.egg-info/           # egg 包元信息目录
dist/                 # 源码分发包输出目录
build/                # 构建输出目录
develop-eggs/         # 开发模式 egg 链接
eggs/                 # egg 包目录
parts/                # buildout 构建部件
sdist/                # 源码分发包目录
var/                  # buildout 变量目录
wheels/               # wheel 分发包目录
pip-wheel-metadata/   # pip wheel 元数据
share/python-wheels/  # 共享 wheel 目录
.installed.cfg        # buildout 安装记录
MANIFEST              # 分发包文件清单
*.manifest            # PyInstaller 清单
*.spec                # PyInstaller 规格文件

# ===========================================================================
# 6. pip 相关（但保留 requirements.txt 作为项目依赖声明）
# ===========================================================================
# requirements.txt 是需要上传的，这里不忽略
pip-log.txt           # pip 安装日志
pip-delete-this-directory.txt

# ===========================================================================
# 7. 测试 & 覆盖率报告
# ===========================================================================
htmlcov/              # HTML 覆盖率报告
.tox/                 # tox 虚拟环境
.nox/                 # nox 虚拟环境
.coverage             # coverage 数据文件
.coverage.*           # coverage 分支数据
.cache                # 缓存目录
nosetests.xml         # nose 测试报告
coverage.xml          # coverage XML 报告
*.cover               # coverage 中间文件
*.py,cover            # coverage 中间文件
.hypothesis/          # hypothesis 测试示例数据库
.pytest_cache/        # pytest 缓存

# ===========================================================================
# 8. 文档构建产物
# ===========================================================================
docs/_build/          # Sphinx 文档构建输出
site/                 # mkdocs 构建输出 (/site 在根目录)

# ===========================================================================
# 9. 机器学习 & 深度学习通用忽略
# ===========================================================================
wandb/                # Weights & Biases 日志目录
mlruns/               # MLflow 运行记录
*.pkl                 # pickle 序列化文件（模型/数据缓存，非必要不上传）
*.h5                  # HDF5 模型权重（Keras/TensorFlow 格式）
*.pb                  # TensorFlow protobuf 图文件
*.onnx                # ONNX 模型导出文件（大文件，不应上传）
*.engine              # TensorRT 引擎文件（大文件，不应上传）
*.mlmodel             # CoreML 模型文件
*.mlpackage           # CoreML 模型包
*.torchscript         # TorchScript 导出文件
*.tflite              # TensorFlow Lite 模型
*_saved_model/        # TensorFlow SavedModel 目录
*_web_model/          # TF.js Web 模型目录
*_openvino_model/     # OpenVINO 模型目录
*_paddle_model/       # PaddlePaddle 模型目录
*_ncnn_model/         # NCNN 模型目录
pnnx*                 # ncnn 工具产物
calibration_*.npy     # INT8 量化校准数据

# ===========================================================================
# 10. 权重无关文件文件（
# ===========================================================================
runs/*                 # YOLOv8 训练/验证/预测结果目录（包含 best.pt, results.csv, 图片等）
# 白名单：保留需要上传的文件夹（示例runs/template）
!runs/predict*/ # 放行所有predict开头的文件夹（如 runs/predict, runs/predict2 等）
# 白名单：保留指定类型文件
!runs/*.yaml # 放行 runs/ 目录下的 YAML 配置文件（如 runs/config.yaml）
!runs/*.pt # 放行 runs/ 目录下的 PyTorch 权重文件（如 runs/best.pt）
!

# ===========================================================================
# 11. 项目配置 & 密钥（敏感信息不上传）
# ===========================================================================
.env                  # 环境变量文件（可能含 API Key）
*.sage.py             # SageMath 解析文件

# ===========================================================================
# 12. .vscode 项目特定配置（已有第3条，此处再次强调）
# ===========================================================================
.idea/                # JetBrains IDE（PyCharm）配置目录
.spyderproject        # Spyder IDE 配置
.spyproject           # Spyder IDE 配置
.ropeproject          # rope 重构工具配置
.mypy_cache/          # mypy 类型检查缓存
.dmypy.json           # mypy daemon 状态
dmypy.json            # mypy daemon 状态
.pyre/                # Pyre 类型检查配置
.ipynb_checkpoints    # Jupyter Notebook 检查点
profile_default/      # IPython profile
ipython_config.py     # IPython 配置

# ===========================================================================
# 13. 数据库 & ORM
# ===========================================================================
*.sqlite3             # SQLite 数据库文件
db.sqlite3-journal    # SQLite WAL 日志

# ===========================================================================
# 14. 数据集 & 测试数据（数据集和测试图片体积大，不应上传到 Git）
# ===========================================================================
VOCdevkit/            # VOC 数据集原始文件（images/ + labels/ + XML 标注），体积大，不上传
/datasets             # 数据集目录（根目录级别），因 docs/en/datasets 需保留，只禁根目录
*.xml                 # VOC 数据集 XML 标注文件（Annotations/ 目录下），体积大，不上传
/*.jpg                # 仅忽略根目录下的测试图片（如 qibao_1.jpg），runs/ 和 VOCdevkit/ 下图片不受影响
/*.png                # 仅忽略根目录下的测试图片（如 V3.png, V4.png, V7.png），runs/ 和 VOCdevkit/ 下图片不受影响
/*.jpeg               # 仅忽略根目录下的测试图片，runs/ 和 VOCdevkit/ 下图片不受影响
yolo_train.txt        # 训练命令备忘文本文件，非项目必要文件
yolo_val.txt          # 验证命令备忘文本文件，非项目必要文件
torch_test            # torch 测试文件，非项目必要文件
Dataset_partitioning.py  # 数据集划分脚本（本地工具脚本，非核心代码）

# ===========================================================================
# 15. 缓存 & 其他
# ===========================================================================
.webassets-cache      # Flask webassets 缓存
.scrapy               # Scrapy 框架目录
target/               # PyBuilder 构建输出
__pypackages__/       # PEP 582 包目录
celerybeat-schedule   # Celery 调度文件
celerybeat.pid        # Celery PID 文件
*.pclprof             # 性能分析文件

# ===========================================================================
# 16. 翻译文件编译产物
# ===========================================================================
*.mo                  # 已编译的翻译文件（.po 编译产物）
*.pot                 # 翻译模板文件

###############################################################################
#                    以下为【不忽略】的说明（保留上传）
###############################################################################
# 不忽略 runs/ 目录，因为 runs/ 下保存着训练/验证/预测结果（best.pt, results.csv, 图片等）
#   排除规则已在上面列出，但 runs/ 本身需要保留，因此不在此处添加 runs/
# 不忽略 ultralytics/cfg/ 下的 *.yaml 数据集配置文件
# 不忽略 scripts/ 下的 Python 脚本
# 不忽略 *.py 源代码文件
# 不忽略 *.yaml  / *.yml 配置文件（但 .github/ 除外，视情况而定）
# 不忽略 *.md 文档文件
# 不忽略 requirements.txt（作为项目依赖声明）
# 不忽略 LICENSE / pyproject.toml 等项目元文件
###############################################################################